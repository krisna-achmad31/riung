    "mk-034": {
      "type": "string",
      "value": [
        {
          "value": "Every monster lives in everyone — the first quiz measures how active each one is (0–100%), not \"have it or not\".",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "Semua monster ada pada semua orang — kuis awal mengukur seberapa aktif tiap monster (0–100%), bukan \"punya atau nggak\".",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
