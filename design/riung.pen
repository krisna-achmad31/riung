    },
    "mk-007": {
      "type": "string",
      "value": [
        {
          "value": "Coming soon to Android · Free to use",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "Segera hadir di Android · Gratis dipakai",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-008": {
      "type": "string",
      "value": [
        {
          "value": "Tame the monsters in your mind.",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "Jinakkan monster dalam pikiranmu.",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-009": {
      "type": "string",
      "value": [
        {
          "value": "The voice that says \"you're going to fail\", the one that keeps you overthinking until you can't sleep, the one that pulls you into endless scrolling — Riung calls them monsters. Get to know them, then tame them with small CBT practices every day.",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "Suara yang bilang \"kamu pasti gagal\", yang bikin overthinking sampai susah tidur, yang ngajak scroll tanpa henti — Riung menyebutnya monster. Kenali mereka, lalu jinakkan lewat latihan CBT kecil setiap hari.",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-010": {
      "type": "string",
      "value": [
        {
          "value": "Meet the monsters",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "Kenalan sama monster",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-011": {
      "type": "string",
      "value": [
        {
          "value": "Your monster progress can't be bought — only practice moves it.",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "Progres monstermu nggak bisa dibeli — cuma latihan yang bisa.",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-012": {
      "type": "string",
      "value": [
        {
          "value": "Morning check-in",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "Check-in pagi",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-013": {
      "type": "string",
      "value": [
        {
          "value": "+5 coins · 1 minute",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "+5 koin · 1 menit",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-014": {
      "type": "string",
      "value": [
        {
          "value": "Si Hakim is calming down",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "Si Hakim mulai tenang",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-015": {
      "type": "string",
      "value": [
        {
          "value": "through practice, not purchases",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "lewat latihan, bukan beli",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-016": {
      "type": "string",
      "value": [
        {
          "value": "MEET YOUR MONSTERS",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "KENALAN SAMA MONSTERMU",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-017": {
      "type": "string",
      "value": [
        {
          "value": "Everyone has monsters. The difference: you can tame yours.",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "Semua orang punya monster. Bedanya, kamu bisa menjinakkannya.",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-018": {
      "type": "string",
      "value": [
        {
          "value": "Riung turns 7 common thinking patterns into monsters you can recognize. It's not you who's wrong — it's just a monster making noise.",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "Riung memvisualisasikan 7 pola pikir yang sering muncul jadi monster yang bisa kamu kenali. Bukan kamu yang salah — itu cuma monster yang lagi ribut.",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-019": {
      "type": "string",
      "value": [
        {
          "value": "BOSS",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "BOS",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-020": {
      "type": "string",
      "value": [
        {
          "value": "The inner critic that judges you — and \"wakes up\" all the other monsters.",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "Suara batin yang menghakimi dirimu — dan yang \"membangunkan\" monster lainnya.",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-021": {
      "type": "string",
      "value": [
        {
          "value": "\"You're going to fail. Like always.\"",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "\"Kamu pasti gagal — kayak biasanya.\"",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-022": {
      "type": "string",
      "value": [
        {
          "value": "Imagines the worst-case scenario",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "Membayangkan skenario terburuk",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-023": {
      "type": "string",
      "value": [
        {
          "value": "\"What if everything falls apart tomorrow?\"",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "\"Gimana kalau besok semuanya berantakan?\"",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-024": {
      "type": "string",
      "value": [
        {
          "value": "Never satisfied with your effort",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "Nggak pernah puas sama usahamu",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-025": {
      "type": "string",
      "value": [
        {
          "value": "\"It should be better than this.\"",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "\"Harusnya bisa lebih baik.\"",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-026": {
      "type": "string",
      "value": [
        {
          "value": "Compares you on social media",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "Membandingkan diri di medsos",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-027": {
      "type": "string",
      "value": [
        {
          "value": "\"Other people's lives look better.\"",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "\"Hidup orang lain lebih oke.\"",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-028": {
      "type": "string",
      "value": [
        {
          "value": "Procrastination & overthinking",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "Menunda & overthinking",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-029": {
      "type": "string",
      "value": [
        {
          "value": "\"Later, there's still time.\"",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "\"Nanti saja.\"",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-030": {
      "type": "string",
      "value": [
        {
          "value": "Runs from what feels uncomfortable",
          "theme": {
            "lang": "en"
          }
        },
        {
          "value": "Kabur dari yang tidak nyaman",
          "theme": {
            "lang": "id"
          }
        }
      ]
    },
    "mk-031": {
      "type": "string",
      "value": [
        {
          "value": "\"Just avoid it, it's safer.\"",
          "theme": {
            "lang": "en"
          }
