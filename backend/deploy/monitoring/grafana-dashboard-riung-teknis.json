    {
      "type": "timeseries",
      "title": "Request per menit menurut status",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({container=\"riung-api\"} | json | event=\"http_request\" | route!=\"/healthz\" | status < 400 [1m]))",
          "queryType": "range",
          "legendFormat": "2xx/3xx"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({container=\"riung-api\"} | json | event=\"http_request\" | status >= 400 | status < 500 [1m]))",
          "queryType": "range",
          "legendFormat": "4xx"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({container=\"riung-api\"} | json | event=\"http_request\" | status >= 500 [1m]))",
          "queryType": "range",
          "legendFormat": "5xx"
        }
