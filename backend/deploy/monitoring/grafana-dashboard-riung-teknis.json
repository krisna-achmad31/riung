    {
      "type": "timeseries",
      "title": "Latensi (ms)",
      "description": "Batas alarm watchdog: p95 > 500 ms (10 menit, min. 50 request).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(quantile_over_time(0.5, {container=\"riung-api\"} | json | event=\"http_request\" | route!=\"/healthz\" | route!=\"/readyz\" | unwrap durationMs [5m]) by (container))",
          "queryType": "range",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(quantile_over_time(0.95, {container=\"riung-api\"} | json | event=\"http_request\" | route!=\"/healthz\" | route!=\"/readyz\" | unwrap durationMs [5m]) by (container))",
          "queryType": "range",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(quantile_over_time(0.99, {container=\"riung-api\"} | json | event=\"http_request\" | route!=\"/healthz\" | route!=\"/readyz\" | unwrap durationMs [5m]) by (container))",
          "queryType": "range",
          "legendFormat": "p99"
        }
