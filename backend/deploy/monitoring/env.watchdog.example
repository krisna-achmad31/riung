# /var/www/riung/.env.watchdog — settings for `riung watchdog` (no secrets;
# Telegram credentials come from .env). See cmd/riung/watchdog.go.
WATCHDOG_API_URL=http://riung-api:8080
WATCHDOG_PUBLIC_URL=https://riung.e55techlab.com/healthz
WATCHDOG_LOKI_URL=http://shared-loki:3100
WATCHDOG_CONTAINER=riung-api
# Backup age comes from the host script (WATCHDOG_BACKUP_NEWEST); the
# container has no access to /var/backups/riung.
WATCHDOG_STATE_FILE=/state/watchdog.json
# Job logs of the watchdog itself would otherwise also go to the API's log tee.
LOG_TEE=
