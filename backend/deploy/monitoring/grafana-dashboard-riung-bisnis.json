    {
      "type": "timeseries",
      "title": "Koin masuk & keluar per hari",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "riung-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "riung-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, sum(earned) FILTER (WHERE type = 'earn') AS \"dari latihan\", sum(purchased) FILTER (WHERE type = 'purchase') AS \"dibeli\", -sum(coins) FILTER (WHERE type = 'spend') AS \"dibelanjakan\", -sum(coins) FILTER (WHERE type = 'refund') AS \"ditarik refund\" FROM metrics.daily_coins WHERE day >= $__timeFrom()::date AND day <= $__timeTo()::date GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "none"
            }
          }
