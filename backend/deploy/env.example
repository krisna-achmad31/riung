# /var/www/riung/.env — riung-api only (chmod 600). Never commit real values.
# Generate secrets with: openssl rand -base64 48
RIUNG_ENV=prod
LOG_LEVEL=info
LISTEN_ADDR=:8080

# DML-only role. Postgres stays inside vps-shared-net, so TLS is not needed.
DATABASE_URL=postgres://riung_app:CHANGE_ME@shared-postgres:5432/riung?sslmode=disable
DB_MAX_CONNS=10
DB_STATEMENT_TIMEOUT=5s

# Only shared-nginx may set X-Real-IP / X-Request-Id.
TRUSTED_PROXIES=172.19.0.2/32

# Secrets (>= 32 chars each, all different, never the dev default):
#   openssl rand -hex 32
LOG_PEPPER=CHANGE_ME
IP_HASH_KEY=CHANGE_ME
PIN_PEPPER=CHANGE_ME
BILLING_ACCOUNT_KEY=CHANGE_ME

# Firebase. The service account (Firebase Authentication Admin) lives in
# ./secrets and is mounted read-only; owner 65532 (distroless nonroot), chmod 400.
FIREBASE_PROJECT_ID=riung-5e979
FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json
# monitor first (log only), switch to enforce once the app sends App Check tokens.
APP_CHECK_MODE=monitor

# Focus ticket signing key: 32 random bytes, base64 (openssl rand -base64 32).
# Rotate by changing both values; the public key is published in /v1/config.
FOCUS_TICKET_KEY=CHANGE_ME
FOCUS_TICKET_KID=k1

# Google Play billing (README step 4c). Leave PLAY_PACKAGE_NAME empty to keep
# billing off: /v1/billing/* then answers 503 and no coins can be bought.
PLAY_PACKAGE_NAME=com.riung.riung
# Service account invited in Play Console (view financial data + manage
# orders and subscriptions). Defaults to FIREBASE_CREDENTIALS_FILE if empty.
PLAY_CREDENTIALS_FILE=/run/secrets/play-service-account.json
# Pub/Sub push subscription for RTDN: OIDC audience and the service account
# the push is signed as (both must match the subscription exactly).
RTDN_AUDIENCE=https://riung.e55techlab.com/v1/webhooks/google-play
RTDN_SERVICE_ACCOUNT=riung-rtdn-push@riung-5e979.iam.gserviceaccount.com

# App Store billing for iOS (README step 4d). Leave APPSTORE_BUNDLE_ID empty to
# keep it off: /v1/billing/appstore/* answers 503, /v1/webhooks/app-store 404.
# iOS bundle id is id.riung.riung (Android package stays com.riung.riung).
APPSTORE_BUNDLE_ID=
# App Store Connect → Users and Access → Integrations → In-App Purchase key.
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY_FILE=/run/secrets/appstore-iap-key.p8
# Numeric Apple ID of the app (App Store Connect → App Information); optional,
# production notifications for another app id are ignored when set.
APPSTORE_APP_APPLE_ID=

# Landing page origin allowed to POST /v1/waitlist from the browser.
CORS_LANDING_ORIGIN=https://CHANGE_ME
# Older app builds get 426 upgrade_required.
MIN_APP_VERSION=1.0.0

# Admin API (docs/backend-api-spec.md §3.11): separate port, never proxied by
# nginx; only the OpenVPN container (VPN clients are MASQUERADEd to it) may connect.
ADMIN_LISTEN_ADDR=:8081
ADMIN_ALLOWED_CIDRS=172.19.0.7/32
