                  "fill": "#FFFFFF",
                  "padding": 12,
                  "children": [
                    {
                      "type": "text",
                      "id": "kxkjC",
                      "fill": "#2D3748",
                      "textGrowth": "fixed-width",
                      "width": 240,
                      "content": "Wajar kok kalau kadang takut sama hal yang belum terjadi. Tapi kayaknya yang lagi ngomong di kepalamu ini Si Waswas deh, yang emang hobinya bikin skenario terburuk. Sini, duduk bentar bareng Riung. Kita tenangkan Si Waswas pelan-pelan ya.",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
