rules_version = '2';

// Riung — Firestore Security Rules.
//
// Wallet & Premium = SERVER-ONLY (CLAUDE.md aturan #5 & #6). Produksi
// memakai REST API Riung (riung.e55techlab.com) untuk semua mutasi koin &
// verifikasi pembelian; jalur Firestore (FirestoreWalletFunctionsService /
// FirestoreUserRepository) hanya cadangan lama dan TIDAK dipakai di build
// rilis (dijaga di main.dart). Karena itu client tidak boleh mengubah
// `wallet` sama sekali, dan tidak boleh menyalakan `premium.active`.
// Dulu (Spark plan) client boleh menulis delta wallet yang "bentuknya sah"
// lewat isValidWalletDelta() — itu bisa di-replay oleh client modifikasi
// (koin duplikat, termasuk +80/330/820 tanpa receipt), jadi dihapus.
// Kalau jalur Firestore diaktifkan lagi, mutasi wallet wajib lewat Cloud
// Functions (Admin SDK melewati rules ini), bukan dengan melonggarkan rules.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidNewUserDoc();
      allow update: if isOwner(uid) && serverFieldsUntouched();
      // Pemilik boleh menghapus datanya sendiri (hapus akun).
      allow delete: if isOwner(uid);

      // Permintaan mutasi koin dari client — hanya catatan/antrian untuk
      // diproses server; tidak pernah mengubah wallet dengan sendirinya.
      match /coinRequests/{reqId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if false;
        allow delete: if isOwner(uid);
      }
    }

    // Konten publik (saboteurs, meditations, affirmations, dst) — cuma
    // diisi manual dari Firebase Console, tidak pernah ditulis dari app.
    match /content/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Waitlist dari landing page (landing/public/waitlist.js) — publik
    // boleh menambah satu email, tidak ada yang bisa membaca/mengubah
    // dari client (dibaca lewat Firebase Console saja).
    match /waitlist/{entryId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'lang', 'source', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function zeroWallet() {
      return {'coins': 0, 'lifetimeEarned': 0, 'lifetimeSpent': 0};
    }

    // Dokumen baru: wallet nol (atau belum ada) dan premium tidak aktif.
    // Saldo/premium hasil migrasi anon→akun dipulihkan oleh server.
    function isValidNewUserDoc() {
      let wallet = request.resource.data.get('wallet', zeroWallet());
      return wallet.get('coins', 0) == 0
        && wallet.get('lifetimeEarned', 0) == 0
        && wallet.get('lifetimeSpent', 0) == 0
        && request.resource.data.get('premium', {}).get('active', false) == false;
    }

    // Update profil/streak/progres boleh, asalkan wallet tidak berubah
    // (dokumen tanpa wallet dianggap wallet nol) dan premium tidak
    // dinyalakan dari client.
    function serverFieldsUntouched() {
      let walletSame = request.resource.data.get('wallet', zeroWallet()) == resource.data.get('wallet', zeroWallet());
      let premiumAfter = request.resource.data.get('premium', {});
      let premiumSame = premiumAfter == resource.data.get('premium', {});
      return walletSame && (premiumSame || premiumAfter.get('active', false) == false);
    }
  }
}
