<?xml version="1.0" encoding="utf-8"?>
<!--
  Data kesehatan mental (jurnal, check-in, hasil tes, profil) tidak boleh
  ikut cadangan cloud Google atau transfer antar-perangkat: sebagian
  disimpan plain di shared_preferences, dan kunci enkripsi jurnal terikat
  Android Keystore sehingga ciphertext hasil restore tidak bisa dibaca
  (penyebab crash flutter_secure_storage). Android 12+ memakai file ini;
  Android 11- memakai android:allowBackup="false" di manifest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
